{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitroute.dev/contracts/v0.1/decision-record.schema.json",
  "title": "HabitRoute Decision Record",
  "description": "Immutable record of a choice under uncertainty, preserving the alternatives and evidence available at decision time. Later outcomes belong in a separate outcome event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "flow_id", "run_id", "habit_id", "habit_version", "constraint_policy", "decided_at", "decision_type", "options_considered", "selected_option_id", "rationale", "evidence_available_at_decision", "uncertainties", "reversibility", "reversal_cost", "decision_maker", "approval"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "decision_id": {"type": "string", "minLength": 1},
    "flow_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "habit_id": {"type": "string", "minLength": 1},
    "habit_version": {"type": "string", "minLength": 1},
    "constraint_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "sha256"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_type": {
      "enum": ["baseline_acceptance", "scope_boundary", "validation_selection", "safe_skip", "retry_or_stop", "approval_or_deny", "failure_classification", "success_verdict", "revalidation", "other"]
    },
    "options_considered": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "description", "eligible", "eligibility_basis"],
        "properties": {
          "option_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "eligible": {"type": "boolean"},
          "eligibility_basis": {"type": "string", "minLength": 1},
          "tradeoffs": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "selected_option_id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_available_at_decision": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "sha256", "observed_at"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "observed_at": {"type": "string", "format": "date-time"},
          "description": {"type": "string"}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "impact"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "impact": {"enum": ["low", "medium", "high", "critical"]},
          "resolution_needed_before_execution": {"type": "boolean"}
        }
      }
    },
    "reversibility": {"enum": ["reversible", "conditionally_reversible", "difficult_to_reverse", "irreversible", "unknown"]},
    "reversal_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "basis"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "estimate_kind": {"enum": ["measured", "estimated", "qualitative"]}
      }
    },
    "decision_maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["agent", "human", "policy", "system"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "pending", "approved", "denied", "expired"]},
        "approver_id": {"type": ["string", "null"]},
        "approval_evidence_ref": {"type": ["string", "null"]}
      }
    }
  }
}