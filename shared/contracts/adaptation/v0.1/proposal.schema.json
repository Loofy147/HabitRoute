{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitroute.dev/contracts/adaptation/v0.1/proposal.schema.json",
  "title": "HabitRoute Retrospective Adaptation Proposal",
  "description": "A non-executable, evidence-attributed hypothesis for a scoped harness or machine-habit change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "created_at",
    "target",
    "source_basis",
    "mechanism",
    "target_behavior",
    "hypothesis",
    "delta",
    "evaluation_plan",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptation/0.1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "definition_sha256",
        "harness_id",
        "harness_version",
        "environment_fingerprint_sha256",
        "task_signature_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "harness_asset",
            "machine_habit",
            "flow_definition"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "harness_id": {
          "type": "string",
          "minLength": 1
        },
        "harness_version": {
          "type": "string",
          "minLength": 1
        },
        "environment_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_signature_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "eligible_held_run_refs",
        "observed_event_refs",
        "prior_basis_refs",
        "causal_link",
        "all_held_runs_revalidated"
      ],
      "properties": {
        "origin": {
          "enum": [
            "experience_driven",
            "prior_driven",
            "weak",
            "mixed"
          ]
        },
        "eligible_held_run_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observed_event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prior_basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "causal_link": {
          "type": "string",
          "minLength": 1
        },
        "all_held_runs_revalidated": {
          "type": "boolean"
        }
      }
    },
    "mechanism": {
      "enum": [
        "executable_check",
        "navigation_pointer",
        "instruction",
        "information_access",
        "tool_configuration",
        "operation_pattern",
        "none"
      ]
    },
    "target_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_signature",
        "opportunity_definition",
        "unit_of_analysis",
        "expected_direction"
      ],
      "properties": {
        "action_signature": {
          "type": "string",
          "minLength": 1
        },
        "opportunity_definition": {
          "type": "string",
          "minLength": 1
        },
        "unit_of_analysis": {
          "const": "matched_task_pair"
        },
        "expected_direction": {
          "enum": [
            "reduce",
            "increase",
            "preserve"
          ]
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "minimum_absolute_rate_change",
        "quality_noninferiority_margin",
        "predicted_side_effects"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "minimum_absolute_rate_change": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "quality_noninferiority_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "predicted_side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_summary",
        "mechanism",
        "artifact_ref",
        "artifact_sha256",
        "changed_paths",
        "atomic_change_unit",
        "rollback_ref"
      ],
      "properties": {
        "change_summary": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "enum": [
            "executable_check",
            "navigation_pointer",
            "instruction",
            "information_access",
            "tool_configuration",
            "operation_pattern",
            "none"
          ]
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "atomic_change_unit": {
          "const": true
        },
        "rollback_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_id",
        "design",
        "min_total_pairs",
        "min_opportunity_pairs",
        "alpha",
        "familywise_comparisons",
        "sample_size_rationale",
        "primary_metric",
        "plan_sha256",
        "preregistered_at"
      ],
      "properties": {
        "design_id": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "enum": [
            "matched_randomized",
            "matched_counterbalanced"
          ]
        },
        "min_total_pairs": {
          "type": "integer",
          "minimum": 2
        },
        "min_opportunity_pairs": {
          "type": "integer",
          "minimum": 2
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.1
        },
        "familywise_comparisons": {
          "type": "integer",
          "minimum": 1
        },
        "sample_size_rationale": {
          "type": "string",
          "minLength": 1
        },
        "primary_metric": {
          "const": "target_action_recurrence"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preregistered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "state": {
      "enum": [
        "proposed",
        "rejected",
        "ready_for_evaluation"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_basis": {
            "properties": {
              "origin": {
                "const": "experience_driven"
              }
            }
          }
        },
        "required": [
          "source_basis"
        ]
      },
      "then": {
        "properties": {
          "source_basis": {
            "properties": {
              "eligible_held_run_refs": {
                "minItems": 1
              },
              "observed_event_refs": {
                "minItems": 1
              },
              "all_held_runs_revalidated": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_basis": {
            "properties": {
              "origin": {
                "const": "mixed"
              }
            }
          }
        },
        "required": [
          "source_basis"
        ]
      },
      "then": {
        "properties": {
          "source_basis": {
            "properties": {
              "eligible_held_run_refs": {
                "minItems": 1
              },
              "observed_event_refs": {
                "minItems": 1
              },
              "prior_basis_refs": {
                "minItems": 1
              },
              "all_held_runs_revalidated": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_basis": {
            "properties": {
              "origin": {
                "const": "prior_driven"
              }
            }
          }
        },
        "required": [
          "source_basis"
        ]
      },
      "then": {
        "properties": {
          "source_basis": {
            "properties": {
              "prior_basis_refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_basis": {
            "properties": {
              "origin": {
                "const": "weak"
              }
            }
          }
        },
        "required": [
          "source_basis"
        ]
      },
      "then": {
        "properties": {
          "source_basis": {
            "anyOf": [
              {
                "properties": {
                  "observed_event_refs": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "prior_basis_refs": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
